# The GSI creates its mainline directories; the vendor AIDL service uses these.
on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    restorecon_recursive /data/vendor/wifi/wpa

# Fixed read-only ioctls under the normal Wi-Fi domain. Shell keeps its
# platform restriction on hardware-address ioctls. No address is changed.
service vendor.rmx-wifi-state /vendor/bin/hw/rmx-wifi-state
    class late_start
    user wifi
    group wifi
    disabled
    oneshot
    timeout_period 5

on property:sys.boot_completed=1
    start vendor.rmx-wifi-state
