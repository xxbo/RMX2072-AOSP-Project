# Native Adreno candidate: source ANGLE GLES over source Turnip/MSM Vulkan.
ro.sf.lcd_density=420
ro.hardware.egl=angle
ro.hardware.vulkan=freedreno
ro.hardware.gralloc=minigbm
ro.hwui.renderer=skiagl
# Keep the accepted linear scanout layout while qualifying hardware rendering.
vendor.minigbm.debug=nocompression

# AOSP phone-xhdpi-6144 profile; measured MemTotal is 7607848 kB.
# See build/m3-dalvik-heap-source.json for the pinned source and values.
dalvik.vm.heapstartsize=16m
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.5
dalvik.vm.heapminfree=8m
dalvik.vm.heapmaxfree=32m
