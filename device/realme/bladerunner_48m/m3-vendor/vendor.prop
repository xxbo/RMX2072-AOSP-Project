# First physical-display integration uses CPU rendering, not Adreno acceleration.
ro.sf.lcd_density=420
ro.hardware.egl=angle
ro.hardware.vulkan=pastel
ro.hardware.gralloc=minigbm
ro.hwui.renderer=skiagl
# SwiftShader maps buffers on the CPU; the MSM allocator must use linear storage.
vendor.minigbm.debug=nocompression
