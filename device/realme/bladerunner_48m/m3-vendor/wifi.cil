; Source vendor AIDL supplicant. Public HAL rules provide nl80211 and binder.
; Mirrors the station/data portions of AOSP android-17.0.0_r1 vendor policy.
(type rmx_wpa)
(type rmx_wpa_exec)
(type wpa_data_file)
(roletype r rmx_wpa)
(roletype object_r rmx_wpa_exec)
(roletype object_r wpa_data_file)
(typeattributeset domain (rmx_wpa))
(typeattributeset netdomain (rmx_wpa))
(typeattributeset halserverdomain (rmx_wpa))
(typeattributeset hal_wifi_supplicant (rmx_wpa))
(typeattributeset hal_wifi_supplicant_server (rmx_wpa))
(typeattributeset file_type (rmx_wpa_exec wpa_data_file))
(typeattributeset exec_type (rmx_wpa_exec))
(typeattributeset vendor_file_type (rmx_wpa_exec))
(typeattributeset data_file_type (wpa_data_file))
(typetransition init rmx_wpa_exec process rmx_wpa)
(allow init rmx_wpa_exec (file (getattr open read execute map)))
(allow init rmx_wpa (process (transition siginh rlimitinh)))
(allow rmx_wpa rmx_wpa_exec (file (getattr open read execute entrypoint map)))
(allow rmx_wpa init (process (sigchld)))
(allow rmx_wpa wpa_data_file (dir (ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow rmx_wpa wpa_data_file (file (ioctl read write create getattr setattr lock append unlink link rename open watch watch_reads)))
(allow rmx_wpa wpa_data_file (sock_file (ioctl read write create getattr setattr lock append unlink link rename open watch watch_reads)))
(allow rmx_wpa wpa_user_data_file (dir (ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow rmx_wpa wpa_user_data_file (file (ioctl read write create getattr setattr lock append unlink link rename open watch watch_reads)))
(allow rmx_wpa wpa_user_data_file (sock_file (ioctl read write create getattr setattr lock append unlink link rename open watch watch_reads)))
(allow rmx_wpa wifi_vendor_user_data_file (dir (search)))
(allow rmx_wpa proc_net_type (file (write)))
(allow rmx_wpa device_logging_prop (file (getattr open read map)))
