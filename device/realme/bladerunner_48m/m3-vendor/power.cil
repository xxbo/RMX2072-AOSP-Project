; Capability-only Power endpoint: no board sysfs, performance or device writes.
; Native thermal class nodes otherwise inherit generic sysfs on this GSI.
; Label only the thermal subtree with the platform's public thermal type.
; Engineering shell may observe temperatures/trips/cooling state, but cannot
; write emul_temp, trip points, cooling state, policy or governor controls.
; This is measurement access, not a Thermal HAL or a thermal-policy change.
(genfscon sysfs "/devices/virtual/thermal" (u object_r sysfs_thermal ((s0) (s0))))
(allow shell sysfs_thermal (dir (getattr search open read)))
(allow shell sysfs_thermal (lnk_file (getattr read)))
(allow shell sysfs_thermal (file (getattr open read)))
(type rmx_power)
(type rmx_power_exec)
(roletype r rmx_power)
(roletype object_r rmx_power_exec)
(typeattributeset domain (rmx_power))
(typeattributeset halserverdomain (rmx_power))
(typeattributeset hal_power (rmx_power))
(typeattributeset hal_power_server (rmx_power))
(typeattributeset file_type (rmx_power_exec))
(typeattributeset exec_type (rmx_power_exec))
(typeattributeset vendor_file_type (rmx_power_exec))
(typetransition init rmx_power_exec process rmx_power)
(allow init rmx_power_exec (file (getattr open read execute map)))
(allow init rmx_power (process (transition siginh rlimitinh)))
(allow rmx_power rmx_power_exec (file (getattr open read execute entrypoint map)))
(allow rmx_power init (process (sigchld)))
