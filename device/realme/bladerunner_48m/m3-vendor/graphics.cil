; Native graphics services on the existing Android 17 platform split policy.
(type rmx_graphics_allocator)
(type rmx_graphics_allocator_exec)
(roletype r rmx_graphics_allocator)
(roletype object_r rmx_graphics_allocator_exec)
(typeattributeset domain (rmx_graphics_allocator))
(typeattributeset halserverdomain (rmx_graphics_allocator))
(typeattributeset hal_graphics_allocator (rmx_graphics_allocator))
(typeattributeset hal_graphics_allocator_server (rmx_graphics_allocator))
(typeattributeset file_type (rmx_graphics_allocator_exec))
(typeattributeset exec_type (rmx_graphics_allocator_exec))
(typeattributeset vendor_file_type (rmx_graphics_allocator_exec))
(typetransition init rmx_graphics_allocator_exec process rmx_graphics_allocator)
(allow init rmx_graphics_allocator_exec (file (getattr open read execute map)))
(allow init rmx_graphics_allocator (process (transition siginh rlimitinh)))
(allow rmx_graphics_allocator rmx_graphics_allocator_exec (file (getattr open read execute entrypoint map)))
(allow rmx_graphics_allocator init (process (sigchld)))
(allow rmx_graphics_allocator graphics_device (dir (search)))
(allow rmx_graphics_allocator graphics_device (chr_file (getattr open read write ioctl map)))
(allow rmx_graphics_allocator gpu_device (chr_file (getattr open read write ioctl map)))

(type rmx_graphics_composer)
(type rmx_graphics_composer_exec)
(roletype r rmx_graphics_composer)
(roletype object_r rmx_graphics_composer_exec)
(typeattributeset domain (rmx_graphics_composer))
(typeattributeset halserverdomain (rmx_graphics_composer))
(typeattributeset hal_graphics_composer (rmx_graphics_composer))
(typeattributeset hal_graphics_composer_server (rmx_graphics_composer))
(typeattributeset file_type (rmx_graphics_composer_exec))
(typeattributeset exec_type (rmx_graphics_composer_exec))
(typeattributeset vendor_file_type (rmx_graphics_composer_exec))
(typetransition init rmx_graphics_composer_exec process rmx_graphics_composer)
(allow init rmx_graphics_composer_exec (file (getattr open read execute map)))
(allow init rmx_graphics_composer (process (transition siginh rlimitinh)))
(allow rmx_graphics_composer rmx_graphics_composer_exec (file (getattr open read execute entrypoint map)))
(allow rmx_graphics_composer init (process (sigchld)))
(typetransition rmx_graphics_composer tmpfs file hal_graphics_composer_server_tmpfs)
(allow rmx_graphics_composer hal_graphics_composer_server_tmpfs (file (getattr map read write)))
(allow rmx_graphics_composer gpu_device (chr_file (getattr open read write ioctl map)))

; Read DRM connector identity. Backlight writes await the observed device path.
(type rmx_display_sysfs)
(roletype object_r rmx_display_sysfs)
(typeattributeset fs_type (rmx_display_sysfs))
(typeattributeset sysfs_type (rmx_display_sysfs))
(genfscon sysfs "/devices/platform/soc/ae00000.display-subsystem" (u object_r rmx_display_sysfs ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/soc:display-core-lab/ae00000.display-subsystem" (u object_r rmx_display_sysfs ((s0) (s0))))
(allow rmx_graphics_composer rmx_display_sysfs (dir (getattr open read search)))
(allow rmx_graphics_composer rmx_display_sysfs (file (getattr open read)))
(allow rmx_graphics_composer rmx_display_sysfs (lnk_file (getattr read)))
