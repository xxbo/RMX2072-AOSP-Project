Subject: [RMX2072 M3] keep pixel parents running and defer DSI reparenting

ACK base: ecdaacc9a0ee87eaf9544e1836d86bd9d590312e.
The DISPCC flag change is from upstream acf7a91d0b0e9e3ef374944021de62062125b7e4
(Val Packett, clk: qcom: dispcc-sm8250: Enable parents for pixel clocks).
Link: https://lore.kernel.org/r/20260312112321.370983-9-val@packett.cool

RMX2072 trial 42 times out updating the pixel RCG. Missing parent preparation
was one candidate cause. The project change reuses ACK's 6g_v2_9 clock acquisition
and deferred-parent logic for an SM8250 node with explicit source clocks.
The matching project DTS removes assigned-clock-parents: parent selection
then runs from host power_on after dsi_mgr_phy_enable, rather than probe.
Old SM8250 DTs and other host revisions keep their existing clock-init path.
Parent errors now propagate, instead of proceeding with an invalid source.

This avoids applying the proposed 7nm DIGTOP bias change, which has an open
SM8350 boot-regression report. No new PHY register values are introduced.
Trial 43 still timed out; these changes alone did not repair the display.
Trial 44 also failed with nonzero CCF prepare/enable references. Add bounded
read-only PHY/PLL state diagnostics at existing driver transitions to compare
software references with the physical PLL control and lock bits.

diff --git a/drivers/clk/qcom/dispcc-sm8250.c b/drivers/clk/qcom/dispcc-sm8250.c
--- a/drivers/clk/qcom/dispcc-sm8250.c
+++ b/drivers/clk/qcom/dispcc-sm8250.c
@@ -578,7 +578,7 @@
 		.name = "disp_cc_mdss_pclk0_clk_src",
 		.parent_data = disp_cc_parent_data_6,
 		.num_parents = ARRAY_SIZE(disp_cc_parent_data_6),
-		.flags = CLK_SET_RATE_PARENT,
+		.flags = CLK_SET_RATE_PARENT | CLK_OPS_PARENT_ENABLE,
 		.ops = &clk_pixel_ops,
 	},
 };
@@ -592,7 +592,7 @@
 		.name = "disp_cc_mdss_pclk1_clk_src",
 		.parent_data = disp_cc_parent_data_6,
 		.num_parents = ARRAY_SIZE(disp_cc_parent_data_6),
-		.flags = CLK_SET_RATE_PARENT,
+		.flags = CLK_SET_RATE_PARENT | CLK_OPS_PARENT_ENABLE,
 		.ops = &clk_pixel_ops,
 	},
 };
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -345,7 +345,11 @@
 				     "%s: can't find dsi_esc clock\n",
 				     __func__);
 
-	if (cfg_hnd->ops->clk_init_ver)
+	/* RMX2072 supplies explicit link sources; select them after PHY enable. */
+	if (of_device_is_compatible(pdev->dev.of_node, "qcom,sm8250-dsi-ctrl") &&
+	    of_property_match_string(pdev->dev.of_node, "clock-names", "byte_src") >= 0)
+		ret = dsi_clk_init_6g_v2_9(msm_host);
+	else if (cfg_hnd->ops->clk_init_ver)
 		ret = cfg_hnd->ops->clk_init_ver(msm_host);
 
 	return ret;
@@ -379,12 +383,39 @@
 	return clk_bulk_prepare_enable(msm_host->num_bus_clks, msm_host->bus_clks);
 }
 
+static int dsi_link_clk_set_parents_6g(struct msm_dsi_host *msm_host)
+{
+	struct device *dev = &msm_host->pdev->dev;
+	int ret;
+
+	/*
+	 * DSI PHY PLLs have to be enabled to allow reparenting to them, so
+	 * cannot use assigned-clock-parents.
+	 */
+	ret = clk_set_parent(msm_host->byte_src_clk, msm_host->dsi_pll_byte_clk);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to parent byte_src -> dsi_pll_byte\n");
+
+	ret = clk_set_parent(msm_host->pixel_src_clk, msm_host->dsi_pll_pixel_clk);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to parent pixel_src -> dsi_pll_pixel\n");
+
+	return 0;
+}
+
 int dsi_link_clk_set_rate_6g(struct msm_dsi_host *msm_host)
 {
 	int ret;
 
 	DBG("Set clk rates: pclk=%lu, byteclk=%lu",
 	    msm_host->pixel_clk_rate, msm_host->byte_clk_rate);
+
+	if (msm_host->byte_src_clk &&
+	    of_device_is_compatible(msm_host->pdev->dev.of_node, "qcom,sm8250-dsi-ctrl")) {
+		ret = dsi_link_clk_set_parents_6g(msm_host);
+		if (ret)
+			return ret;
+	}
 
 	ret = dev_pm_opp_set_rate(&msm_host->pdev->dev,
 				  msm_host->byte_clk_rate);
@@ -413,21 +444,10 @@
 
 int dsi_link_clk_set_rate_6g_v2_9(struct msm_dsi_host *msm_host)
 {
-	struct device *dev = &msm_host->pdev->dev;
-	int ret;
-
-	/*
-	 * DSI PHY PLLs have to be enabled to allow reparenting to them, so
-	 * cannot use assigned-clock-parents.
-	 */
-	ret = clk_set_parent(msm_host->byte_src_clk, msm_host->dsi_pll_byte_clk);
+	int ret = dsi_link_clk_set_parents_6g(msm_host);
+
 	if (ret)
-		dev_err(dev, "Failed to parent byte_src -> dsi_pll_byte: %d\n", ret);
-
-	ret = clk_set_parent(msm_host->pixel_src_clk, msm_host->dsi_pll_pixel_clk);
-	if (ret)
-		dev_err(dev, "Failed to parent pixel_src -> dsi_pll_pixel: %d\n", ret);
-
+		return ret;
 	return dsi_link_clk_set_rate_6g(msm_host);
 }
 
