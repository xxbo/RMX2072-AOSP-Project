+/* phase: 0=power-ready, 1=kickoff-ready, 2=PP-done, 3=IRQ-preclear,
+ * 4=host-enable, 5=DPU-underrun. The caller already owns active HW/PM.
+ * Reads use registers cleared by explicit writes in the normal IRQ path.
+ * First 16 samples per phase, per host, per boot; no rearming or writes.
+ */
+static void dsi_ff_sample(struct msm_dsi_host *msm_host, u32 phase, u32 cookie)
+{
+	u32 v[8];
+
+	if (!trace_rmx_dsi_sample_enabled() || msm_host->id != 0 ||
+	    phase >= ARRAY_SIZE(msm_host->ff_sample_count) ||
+	    atomic_read(&msm_host->ff_sample_count[phase]) >= 16)
+		return;
+	if (atomic_inc_return(&msm_host->ff_sample_count[phase]) > 16)
+		return;
+	v[0] = dsi_read(msm_host, REG_DSI_INTR_CTRL);
+	v[1] = dsi_read(msm_host, REG_DSI_STATUS0);
+	v[2] = dsi_read(msm_host, REG_DSI_FIFO_STATUS);
+	v[3] = dsi_read(msm_host, REG_DSI_ACK_ERR_STATUS);
+	v[4] = dsi_read(msm_host, REG_DSI_TIMEOUT_STATUS);
+	v[5] = dsi_read(msm_host, REG_DSI_DLN0_PHY_ERR);
+	v[6] = dsi_read(msm_host, REG_DSI_CLK_STATUS);
+	v[7] = dsi_read(msm_host, REG_DSI_ERR_INT_MASK0);
+	trace_rmx_dsi_sample(phase, msm_host->id, cookie, v);
+}
+
+void msm_dsi_host_first_frame_sample(struct mipi_dsi_host *host,
+				   u32 phase, u32 cookie)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+
+	/* DPU calls only on active command-mode commit/IRQ paths. */
+	if (READ_ONCE(msm_host->power_on))
+		dsi_ff_sample(msm_host, phase, cookie);
+}
+
 static inline void dsi_write(struct msm_dsi_host *msm_host, u32 reg, u32 data)
 {
 	writel(data, msm_host->ctrl_base + reg);
@@ -420,6 +459,10 @@ int dsi_link_clk_set_rate_6g(struct msm_dsi_host *msm_host)
