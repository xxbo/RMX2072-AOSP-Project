diff --git a/drivers/gpu/drm/msm/rmx2072_trace.h b/drivers/gpu/drm/msm/rmx2072_trace.h
new file mode 100644
index 0000000..9c7f624
--- /dev/null
+++ b/drivers/gpu/drm/msm/rmx2072_trace.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM rmx2072_display
+
+#if !defined(_RMX2072_DISPLAY_TRACE_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _RMX2072_DISPLAY_TRACE_H
+
+#include <linux/tracepoint.h>
+
+/* Fixed-size records only. No printing, allocation or clock API in IRQs. */
+TRACE_EVENT(rmx_dsi_sample,
+	TP_PROTO(u32 phase, u32 id, u32 cookie, const u32 *v),
+	TP_ARGS(phase, id, cookie, v),
+	TP_STRUCT__entry(
+		__field(u32, phase)
+		__field(u32, id)
+		__field(u32, cookie)
+		__array(u32, v, 8)
+	),
+	TP_fast_assign(
+		__entry->phase = phase;
+		__entry->id = id;
+		__entry->cookie = cookie;
+		memcpy(__entry->v, v, sizeof(__entry->v));
+	),
+	TP_printk("phase=%u id=%u cookie=%u irq=%#x status=%#x fifo=%#x ack=%#x timeout=%#x phy=%#x clk=%#x mask=%#x",
+		__entry->phase, __entry->id, __entry->cookie,
+		__entry->v[0], __entry->v[1], __entry->v[2], __entry->v[3],
+		__entry->v[4], __entry->v[5], __entry->v[6], __entry->v[7])
+);
+
+TRACE_EVENT(rmx_display_step,
+	TP_PROTO(const char *step, u32 id, u64 a, u64 b, u64 c, u64 d),
+	TP_ARGS(step, id, a, b, c, d),
+	TP_STRUCT__entry(
+		__string(step, step)
+		__field(u32, id)
+		__field(u64, a)
+		__field(u64, b)
+		__field(u64, c)
+		__field(u64, d)
+	),
+	TP_fast_assign(
+		__assign_str(step);
+		__entry->id = id;
+		__entry->a = a;
+		__entry->b = b;
+		__entry->c = c;
+		__entry->d = d;
+	),
+	TP_printk("step=%s id=%u a=%llu b=%llu c=%llu d=%llu",
+		__get_str(step), __entry->id, __entry->a, __entry->b,
+		__entry->c, __entry->d)
+);
+
+#endif
+
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH .
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE rmx2072_trace
+#include <trace/define_trace.h>
