+	}
+
 	/* TODO: make sure dsi_cmd_mdp is idle.
 	 * Since DSI6G v1.2.0, we can set DSI_TRIG_CTRL.BLOCK_DMA_WITHIN_FRAME
 	 * to ask H/W to wait until cmd mdp is idle. S/W wait is not needed.
@@ -2296,6 +2354,8 @@ void msm_dsi_host_xfer_restore(struct mipi_dsi_host *host,
 
 	/* TODO: unvote for bus bandwidth */
 
+	trace_rmx_display_step("dcs-end", msm_host->id,
+		msm_host->ff_xfer_seq, msg->type, msg->tx_len, msg->flags);
 	cfg_hnd->ops->link_clk_disable(msm_host);
 	pm_runtime_put(&msm_host->pdev->dev);
 }
@@ -2536,6 +2596,7 @@ int msm_dsi_host_enable(struct mipi_dsi_host *host)
 	 * }
 	 */
 	msm_host->enabled = true;
+	dsi_ff_sample(msm_host, 4, 0);
 	return 0;
 }
 
@@ -2620,6 +2681,7 @@ int msm_dsi_host_power_on(struct mipi_dsi_host *host,
