 module_param_cb(download_mode, &download_mode_param_ops, NULL, 0644);
 MODULE_PARM_DESC(download_mode, "download mode: off/0/N for no dump mode, full/on/1/Y for full dump mode, mini for minidump mode and full,mini for both full and minidump mode together are acceptable values");
 
+/* Only the RMX2072 F.20 diagnostic tree uses this downstream EDL convention. */
+static int rmx2072_edl_reboot(struct notifier_block *nb, unsigned long action,
+			      void *cmd)
+{
+	struct qcom_scm *scm = container_of(nb, struct qcom_scm, edl_reboot);
+
+	scm->edl_requested = action == SYS_RESTART && cmd && !strcmp(cmd, "edl");
+	if (scm->edl_requested)
+		reboot_mode = REBOOT_WARM;
+
+	return NOTIFY_DONE;
+}
+
+static int rmx2072_request_edl(struct device *dev)
+{
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_BOOT,
+		.cmd = QCOM_SCM_BOOT_SET_DLOAD_MODE,
+		.arginfo = QCOM_SCM_ARGS(2),
+		.args = { BIT(0), 0 }, /* downstream SCM_EDLOAD_MODE */
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct device_node *np;
+	struct resource res;
+	int idx, ret;
+
+	if (__qcom_scm_is_call_available(dev, desc.svc, desc.cmd))
+		return qcom_scm_call_atomic(dev, &desc, NULL);
+
+	/* F.20 falls back to a secure write to this named PS_HOLD resource. */
+	np = of_find_compatible_node(NULL, NULL, "qcom,pshold");
+	if (!np)
+		return -ENODEV;
+	idx = of_property_match_string(np, "reg-names", "tcsr-boot-misc-detect");
+	ret = idx < 0 ? idx : of_address_to_resource(np, idx, &res);
+	of_node_put(np);
+	if (ret)
+		return ret;
+	if (res.start != 0x1fd3000 || resource_size(&res) != sizeof(u32))
+		return -EINVAL;
+	return qcom_scm_io_writel(res.start, BIT(0));
+}
