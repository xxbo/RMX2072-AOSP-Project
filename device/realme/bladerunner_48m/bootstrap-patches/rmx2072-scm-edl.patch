 	scm = devm_kzalloc(&pdev->dev, sizeof(*scm), GFP_KERNEL);
@@ -2408,6 +2455,14 @@
 					     "Failed to request qcom-scm irq\n");
 	}
 
+	if (of_machine_is_compatible("qcom,kona-mtp") &&
+	    !of_property_read_u32(of_root, "oplus,dtsi_no", &board) && board == 20607 &&
+	    of_device_is_compatible(pdev->dev.of_node, "qcom,scm-sm8250")) {
+		scm->edl_reboot.notifier_call = rmx2072_edl_reboot;
+		ret = devm_register_reboot_notifier(scm->dev, &scm->edl_reboot);
+		if (ret)
+			return ret;
+	}
 	/*
 	 * Paired with smp_load_acquire() in qcom_scm_is_available().
 	 *
@@ -2453,6 +2508,13 @@
 
 static void qcom_scm_shutdown(struct platform_device *pdev)
 {
+	if (__scm->edl_requested) {
+		int ret = rmx2072_request_edl(&pdev->dev);
+
+		dev_emerg(&pdev->dev, "RMX2072 explicit EDL request: %d\n", ret);
+		if (!ret)
+			return;
+	}
 	/* Clean shutdown, disable download mode to allow normal restart */
 	qcom_scm_set_download_mode(QCOM_DLOAD_NODUMP);
 }
