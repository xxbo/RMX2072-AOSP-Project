+/* Temporary M1 bridge for the measured F.20 node. Project DTs will use the
+ * upstream binding. Never claim the legacy secondary/modem PON instances. */
+static bool rmx2072_primary_pon(struct device_node *np)
+{
+	static const u32 expected_irqs[] = { 0, 8, 0, 3, 0, 8, 1, 3 };
+	struct device_node *parent = of_get_parent(np);
+	u32 board, reg[2], sid[2], irqs[8];
+	bool valid;
+
+	valid = of_machine_is_compatible("qcom,kona-mtp") &&
+		!of_property_read_u32(of_root, "oplus,dtsi_no", &board) &&
+		board == 20607 && parent &&
+		of_device_is_compatible(parent, "qcom,spmi-pmic") &&
+		of_property_read_bool(np, "qcom,system-reset") &&
+		of_property_count_u32_elems(parent, "reg") == 2 &&
+		!of_property_read_u32_array(parent, "reg", sid, 2) &&
+		sid[0] == 0 && sid[1] == 0 &&
+		of_property_count_u32_elems(np, "reg") == 2 &&
+		!of_property_read_u32_array(np, "reg", reg, 2) &&
+		reg[0] == 0x800 && reg[1] == 0x100 &&
+		of_property_count_u32_elems(np, "interrupts") == 8 &&
+		!of_property_read_u32_array(np, "interrupts", irqs, 8) &&
+		!memcmp(irqs, expected_irqs, sizeof(irqs));
+	of_node_put(parent);
+	return valid;
+}
