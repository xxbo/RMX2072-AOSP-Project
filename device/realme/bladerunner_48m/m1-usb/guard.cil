; Restricted engineering watchdog owner. No reboot capability or UFS access.
(type rmx_m1_guard)
(type rmx_m1_guard_exec)
(roletype r rmx_m1_guard)
(roletype object_r rmx_m1_guard_exec)
(typeattributeset domain (rmx_m1_guard))
(typeattributeset file_type (rmx_m1_guard_exec))
(typeattributeset exec_type (rmx_m1_guard_exec))
(typeattributeset vendor_file_type (rmx_m1_guard_exec))
(typetransition init rmx_m1_guard_exec process rmx_m1_guard)
(allow init rmx_m1_guard_exec (file (getattr open read execute map)))
(allow init rmx_m1_guard (process (transition siginh rlimitinh)))
(allow rmx_m1_guard rmx_m1_guard_exec (file (getattr open read execute entrypoint map)))
(allow rmx_m1_guard init (process (sigchld)))
(allow rmx_m1_guard watchdog_device (chr_file (getattr open read write ioctl)))
(allow rmx_m1_guard kmsg_device (chr_file (open write)))
(allow rmx_m1_guard proc_random (dir (search)))
(allow rmx_m1_guard proc_random (file (getattr open read)))
(type rmx_m1_control_prop)
(roletype object_r rmx_m1_control_prop)
(typeattributeset property_type (rmx_m1_control_prop))
(typeattributeset vendor_property_type (rmx_m1_control_prop))
(typeattributeset vendor_public_property_type (rmx_m1_control_prop))
(allow rmx_m1_guard rmx_m1_control_prop (file (getattr open read map)))
(allow rmx_m1_guard rmx_m1_control_prop (property_service (set)))
(allow rmx_m1_guard property_socket (sock_file (write)))
(allow rmx_m1_guard init (unix_stream_socket (connectto)))
(allow shell rmx_m1_control_prop (file (getattr open read map)))
(allow vendor_init rmx_m1_control_prop (property_service (set)))

(type rmx_m1_guard_socket)
(roletype object_r rmx_m1_guard_socket)
(typeattributeset file_type (rmx_m1_guard_socket))
(allow rmx_m1_guard rmx_m1_guard (unix_stream_socket (create bind listen accept read write getattr getopt setopt)))
(allow vendor_shell rmx_m1_guard_socket (sock_file (write)))
(allow vendor_shell rmx_m1_guard (unix_stream_socket (connectto)))
