; Private F.20 HAL comparison on the 202604 GSI split policy.
(type rmx_keymaster)
(type rmx_keymaster_exec)
(roletype object_r rmx_keymaster_exec)
(roletype r rmx_keymaster)
(typeattributeset domain (rmx_keymaster))
(typeattributeset halserverdomain (rmx_keymaster))
(typeattributeset hal_keymaster (rmx_keymaster))
(typeattributeset hal_keymaster_server (rmx_keymaster))
(typeattributeset file_type (rmx_keymaster_exec))
(typeattributeset exec_type (rmx_keymaster_exec))
(typeattributeset vendor_file_type (rmx_keymaster_exec))
(typetransition init rmx_keymaster_exec process rmx_keymaster)
(allow init rmx_keymaster_exec (file (getattr open read execute map)))
(allow init rmx_keymaster (process (transition siginh rlimitinh)))
(allow rmx_keymaster rmx_keymaster_exec (file (getattr open read execute entrypoint map)))
(allow rmx_keymaster init (process (sigchld)))
(allow rmx_keymaster hwservicemanager (binder (call transfer)))
(allow hwservicemanager rmx_keymaster (binder (call transfer)))
(allow hwservicemanager rmx_keymaster (dir (search)))
(allow hwservicemanager rmx_keymaster (file (open read)))
(allow hwservicemanager rmx_keymaster (process (getattr)))
