# SPDX-License-Identifier: GPL-2.0-only
# QCA6390 PCIe prerequisites from the pinned ACK 6.18 tree.
# Building these does not assert PCIe enumeration, firmware/calibration or Wi-Fi.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
# GKI defaults RFKILL to m; CFG80211 cannot be built in above that dependency.
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_MHI_BUS=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
